@model PagedList.IPagedList<WebBanHangOnline.Models.EF.Voucher>
@using PagedList.Mvc;
@using WebBanHangOnline.Models.Common;
@{
    ViewBag.Title = "Danh sách voucher";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
@section naviheader{
    <!-- Left navbar links -->
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fa fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin/home" class="nav-link">Trang chủ</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin/voucher" class="nav-link">@ViewBag.Title</a>
        </li>
    </ul>
}
<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>@ViewBag.Title</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/admin/home">Trang chủ</a></li>
                    <li class="breadcrumb-item active">@ViewBag.Title</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">

    <!-- Default box -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">@ViewBag.Title</h3>

            <div class="card-tools">
                <a href="/admin/voucher/add" class="btn btn-primary">Thêm mới </a>
                
            </div>
        </div>
        <div class="card-body">
            
            <table class="table table-hover ">
                <thead>
                    <tr>
                        
                        <th>STT</th>
                        <th>Tiêu đề</th>
                        <th>Mô tả</th>
                        <th>Giá giảm</th>
                        <th>Phần trăm giảm</th>
                        <th>Ngày tạo</th>
                        <th>Code</th>
                        <th style="width: 150px"></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var i = ((ViewBag.Page - 1) * ViewBag.PageSize) + 1;
                        foreach (var item in Model)
                        {
                            <tr id="trow_@item.Id">
                                
                                <td>@(i++)</td>
                                <td>@item.Title</td>
                                <td>@item.Description</td>
                                <td>@FormatNumber.FormatNumber1(Convert.ToInt32(@item.ReducePrice)) đ</td>
                                <td class="text-center">@item.PercentReduce %</td>
                                <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                                <td>@item.VoucherCode</td>
                                <td>
                                    <a href="/admin/voucher/edit/@item.Id" class="btn btn-primary">Sửa</a>
                                    <a href="#" data-id="@item.Id" class="btn btn-danger btnDelete">Xóa</a>
                                </td>
                            </tr>


                        }


                    }
                    else
                    {
                        <tr>
                            <td colspan="4">Không có bản ghi nào!!!</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="row">
                <div class="col-6"></div>
                <div class="col-6" style="text-align: right">
                    @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
                </div>
            </div>

        </div>
        <!-- /.card-body -->
        <div class="card-footer">

        </div>
        <!-- /.card-footer-->
    </div>
    <!-- /.card -->

</section>
<!-- /.content -->

@section scripts{
    <script>
        $(document).ready(function () {
          
            $('body').on('click', '.btnDelete', function () {
                var id = $(this).data("id")
                var conf = confirm('Bạn có muốn xóa không?')
                if (conf) {
                    $.ajax({
                        url: '/admin/voucher/delete',
                        type: 'POST',
                        data: { id: id },
                        success: function (rs) {

                            if (rs.success)
                                $('#trow_' + id).remove()
                        }
                    })
                }
            })
          
        })
    </script>
}
